rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Catálogo y configuración (acceso abierto — admin sin Firebase Auth) ──
    match /products/{id} {
      allow read, write: if true;
    }
    match /store/{id} {
      allow read, write: if true;
    }
    match /textBlocks/{id} {
      allow read, write: if true;
    }

    // ── Lista de espera ──
    // create: cualquiera puede anotarse (clientas sin cuenta), validando estructura
    // read / update / delete: abierto (admin no usa Firebase Auth en este proyecto)
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                        'nombre', 'whatsapp', 'productoId',
                        'productoNombre', 'fecha', 'notificada'
                      ])
                   && request.resource.data.nombre is string
                   && request.resource.data.nombre.size() > 0
                   && request.resource.data.whatsapp is string
                   && request.resource.data.whatsapp.size() >= 10
                   && request.resource.data.productoId is string
                   && request.resource.data.productoNombre is string
                   && request.resource.data.notificada == false;

      allow read, update, delete: if true;
    }

    // ── Analíticas: visitas y productos vistos ──
    // create: cualquier visita del público, validando estructura
    // read / delete: abierto (solo se muestra en el panel admin, admin no usa Firebase Auth en este proyecto)
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fecha', 'dateStr', 'hour', 'source'])
                   && request.resource.data.dateStr is string
                   && request.resource.data.hour is int
                   && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
                   && request.resource.data.source is string;

      allow read, delete: if true;
    }

    match /productViews/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                        'productId', 'productName', 'fecha', 'dateStr', 'hour', 'source'
                      ])
                   && request.resource.data.productId is string
                   && request.resource.data.productName is string
                   && request.resource.data.dateStr is string
                   && request.resource.data.hour is int
                   && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
                   && request.resource.data.source is string;

      allow read, delete: if true;
    }

  }
}
